<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Live Workout's rep-detected haptic buzz (see com.repmate.ui.workout.RepFeedback). A
         normal, not dangerous, permission: granted at install, no runtime prompt needed. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- The push-up camera workout (com.repmate.ui.workout.pushup). Dangerous, so it's requested
         at runtime with a reason; see PushupWorkoutScreen's permission rationale. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- required="false": the rest of the app is IMU-only and must still install on a phone with
         no camera; only Push-up is unavailable there. -->
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <application
        android:name=".RepMateApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.RepMate">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.RepMate"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          SensorProbeActivity is deliberately NOT declared here. It is the engine team's sensor
          bring-up harness, and it is exported, so declaring it in this manifest would make it
          launchable by any app on the device in a shipped release build. Its declaration lives
          in app/src/debug/AndroidManifest.xml instead, which the manifest merger folds into the
          debug variant only.
        -->
    </application>

</manifest>