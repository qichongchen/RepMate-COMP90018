<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:name=".RepMateApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.RepMate">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.RepMate"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Sensor bring-up harness for the engine team, not part of the app's real navigation
          flow, so it deliberately has no intent-filter and isn't the launcher. Still kept and
          exported so it can be launched directly when someone needs to check the live sensor
          pipeline on a device:
              adb shell am start -n com.example.repmate/.SensorProbeActivity
          (or add an Android Studio run configuration targeting this Activity specifically).
          See the KDoc in SensorProbeActivity.kt for what it measures and when it's safe to
          delete for good.
        -->
        <activity
            android:name=".SensorProbeActivity"
            android:exported="true"
            android:label="RepMate sensor probe"
            android:theme="@style/Theme.RepMate" />
    </application>

</manifest>