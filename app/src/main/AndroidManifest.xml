<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Live Workout's rep-detected haptic buzz (see com.repmate.ui.workout.RepFeedback). A
         normal, not dangerous, permission: granted at install, no runtime prompt needed. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- The push-up camera workout (com.repmate.ui.workout.pushup). Dangerous, so it's requested
         at runtime with a reason; see PushupWorkoutScreen's permission rationale. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- required="false": the rest of the app is IMU-only and must still install on a phone with
         no camera; only Push-up is unavailable there. -->
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <!-- Safety check-in (com.repmate.safety), opted into from Profile. All three are dangerous
         and requested at runtime with the disclaimer/rationale in ProfileScreen; SEND_SMS is the
         one whose denial keeps the feature off (see SmsSafetyAlertSender's KDoc), the other two
         degrade gracefully (no location in the alert / no "are you okay" notification). -->
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".RepMateApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.RepMate">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.RepMate"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          SensorProbeActivity is deliberately NOT declared here. It is the engine team's sensor
          bring-up harness, and it is exported, so declaring it in this manifest would make it
          launchable by any app on the device in a shipped release build. Its declaration lives
          in app/src/debug/AndroidManifest.xml instead, which the manifest merger folds into the
          debug variant only.
        -->

        <!-- Handles the "I'm OK" action tapped on the safety check-in notification (see
             CheckInNotificationPresenter). Not exported: only this app's own PendingIntent
             invokes it, there is no reason for another app to be able to trigger it. -->
        <receiver
            android:name="com.repmate.safety.CheckInAckReceiver"
            android:exported="false" />

        <!-- Opts into on-demand WorkManager initialization (RepMateApplication.Configuration.Provider)
             instead of the default eager one, which is what lets HiltWorkerFactory supply
             CheckInNotifyWorker/CheckInEscalateWorker's real dependencies. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>