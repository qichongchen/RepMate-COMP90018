# Ground truth for squat_10_hit.csv
#
# Second recording, and the first from a different person and a different phone.
#
# This trace sets both ends of the amplitude band. Measured through the 250 ms filter,
# Hit's softest real rep swings 1.03 and the recording contains the 0.83-amplitude, 743 ms
# wobble at ~63.5 s that minAmplitude exists to reject. The whole amplitude floor rests on
# this one participant.
#
# Those figures were 0.92, 0.60 and 501 ms when the filter was a fixed 25 samples, which at
# this trace's ~58 Hz spanned 430 ms rather than 250 ms. Normalising the filter moved them,
# and the wobble is now LONGER than the shortest genuine rep in the library (615 ms), so
# minRepDurationMs can no longer help reject it. See the redundancy note in RepDetector.

exercise = SQUAT

# 10 squats at a faster ~3 s cadence than the baseline recording's 4-5 s.
reps = 10
setStartMs = 55000
setEndMs = 102000

# Was 13 until maxRepDurationMs was added. The thirteenth was never a movement event:
# after the last squat the phone is parked reading ~9.81, which sits between lowThreshold
# (9.7) and highThreshold (10.15), so the window opened at 100.9 s and nothing ever closed
# it -- 36.9 s reported as one rep. It is now abandoned mid-flight, and the remaining 12 are
# unchanged: the 10 squats, a 0.59 s burst at ~5.6 s, and the 2.20 s phone-into-pocket burst
# at ~7.4 s, which is real movement and still counts.
fullTraceEvents = 12

# Hit stood still for roughly the first 55 s of the recording, so this stretch is a
# false-positive check on real data rather than on a synthetic still period.
quietStartMs = 15000
quietEndMs = 50000

notes = participant: Hit (~3s cadence). Samsung SM-S936B, ~58Hz, right front pocket. Softest reps of the three traces; sets both ends of the amplitude band.
