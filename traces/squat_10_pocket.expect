# Ground truth for squat_10_pocket.csv
#
# Recorded with the Sensor Logger app, phone in a trouser pocket, Total Acceleration
# export at ~99 Hz. One person, one pace. The detector's thresholds were tuned against
# this recording, so it is the baseline every other trace is compared to.

exercise = SQUAT

# 10 squats were performed, all inside the window below, at a steady 4-5 s cadence.
reps = 10
setStartMs = 12000
setEndMs = 54000
tolerance = 0

# Over the whole recording the detector sees 12 events: the 10 squats plus two
# phone-handling bursts, one at ~3.5 s (phone going into the pocket after the recording
# was started) and one at ~63.2 s (phone coming back out to stop it). Both clear every
# guard and are genuine movement; excluding them is a session-trimming job, not a
# threshold job.
fullTraceEvents = 12

# After the last squat ends (~53.6 s) and before the phone is retrieved (~63.2 s) it lies
# still in the pocket. Nothing may be detected here.
quietStartMs = 54000
quietEndMs = 62000

notes = Baseline recording; thresholds in SquatRepDetector are tuned to it.
